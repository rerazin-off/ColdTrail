{
  "info": {
    "_postman_id": "4cf860e8-d411-4bb7-bacb-c63dcb7f47cb",
    "name": "ColdTrailApi",
    "description": "Проверка серверной части (Supabase): авторизация, дела, игровые данные, заметки, ИИ и обвинение. Нужны переменные окружения base_url и anon_key; остальные (access_token, case_id и т. д.) заполняются скриптами автоматически. Запросы выполняйте по порядку сверху вниз.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59514387",
    "_collection_link": "https://go.postman.co/collection/59514387-4cf860e8-d411-4bb7-bacb-c63dcb7f47cb?source=collection_link"
  },
  "item": [
    {
      "name": "01. Авторизация",
      "item": [
        {
          "name": "Sing up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"TestPass123!\",\n  \"data\": {\n    \"nickname\": \"Detective\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/v1/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "signup"
              ]
            },
            "description": "Регистрация игрока. Поле data.nickname попадает в профиль. Если в Supabase включено подтверждение почты, сначала подтвердите адрес."
          },
          "response": []
        },
        {
          "name": "Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// pm.test(\"Successful POST request\", function () {\n//     pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n// });\nconst data = pm.response.json();\n\nif (pm.response.code === 200 && data.access_token) {\n    pm.environment.set(\"access_token\", data.access_token);\n    pm.environment.set(\"refresh_token\", data.refresh_token);\n    pm.environment.set(\"user_id\", data.user.id);\n\n    console.log(\"Access token сохранён\");\n} else {\n    console.log(\"Не удалось сохранить токен\");\n}\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"TestPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Вход по email и паролю. Скрипт сохраняет access_token, refresh_token и user_id в переменные окружения."
          },
          "response": []
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "if (data.access_token) {",
                  "    pm.environment.set(\"access_token\", data.access_token);",
                  "    pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "    if (data.user && data.user.id) pm.environment.set(\"user_id\", data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"refresh_token\": \"{{refresh_token}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=refresh_token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                }
              ]
            },
            "description": "Обновление токена по refresh_token. Новые токены сохраняются в переменные окружения."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Дела и расследования",
      "item": [
        {
          "name": "Get Cases",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"Есть заголовок Content-Range\", function () { pm.expect(pm.response.headers.has(\"Content-Range\")).to.be.true; });",
                  "const d = pm.response.json();",
                  "if (Array.isArray(d) && d.length) { pm.environment.set(\"case_id\", d[0].id); console.log(\"case_id =\", d[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Prefer",
                "value": "count=exact"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/cases?select=*&limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "cases"
              ],
              "query": [
                {
                  "key": "select",
                  "value": "*"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Список дел, постранично (limit/offset). Заголовок Prefer: count=exact добавляет в ответ Content-Range. Скрипт сохраняет id первого дела в case_id."
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "event": [
            {
              "listen": "test",
