        {
          "name": "Init investigation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201,409\", function () { pm.expect(pm.response.code).to.be.oneOf([201,409]); });",
                  "if (pm.response.code === 201) {",
                  "    const d = pm.response.json();",
                  "    pm.environment.set(\"investigation_id\", d[0].id);",
                  "    console.log(\"investigation_id =\", d[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": {{case_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rest/v1/investigations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "investigations"
              ]
            },
            "description": "Начать расследование по делу case_id. user_id подставляется из токена. 409 — расследование по этому делу уже начато (это нормально)."
          },
          "response": []
        }
      ]
    },
